# Database (Postgres — run `docker compose up -d` for a local instance, matching production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/multiplatformposter"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string" # generate with: openssl rand -base64 32

# Secret used to authorize the scheduled-post publisher endpoint (/api/cron/publish)
CRON_SECRET="replace-with-a-long-random-string"

# X (Twitter) — https://developer.twitter.com, create a project + app with OAuth 2.0 enabled
# Callback URL to register: {NEXTAUTH_URL}/api/accounts/twitter/callback
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# Instagram — https://developers.facebook.com, create a Meta app with the
# Instagram Graph API product, linked to a Facebook Page + Instagram
# professional (business/creator) account.
# Callback URL to register: {NEXTAUTH_URL}/api/accounts/instagram/callback
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# TikTok — https://developers.tiktok.com, create an app with Login Kit +
# Content Posting API (video.publish scope requires app review).
# Callback URL to register: {NEXTAUTH_URL}/api/accounts/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
